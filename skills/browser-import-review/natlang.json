{
  "schema": "natlang.package/v2",
  "name": "vibestudio-browser-import-review",
  "version": "0.1.0",
  "targets": { "main": { "entry": "reviewBrowserImport.nl" } },
  "serviceBinding": "explicit",
  "serviceScopes": {
    "browserImportStart": [
      "reviewBrowserImport/executeApprovedImport/startApprovedImport.nl"
    ],
    "browserImportSource": ["reviewBrowserImport/inspectAssignedSource.nl"],
    "browserImportPreview": ["reviewBrowserImport/inspectPreview.nl"],
    "browserImportHistory": ["reviewBrowserImport/inspectRetainedJob.nl"]
  }
}
