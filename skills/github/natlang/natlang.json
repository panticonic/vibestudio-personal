{
  "schema": "natlang.package/v2",
  "name": "personal-github-setup",
  "version": "0.1.0",
  "include": [
    "workOnGitHubGoal.nl",
    "workOnGitHubGoal",
    "reviewGitHubSetup.nl",
    "reviewGitHubSetup",
    "diagnoseGitHubOperation.nl",
    "diagnoseGitHubOperation",
    "accessLevelFor.nl",
    "troubleshootGithub.nl",
    "troubleshootGithub",
    "types.ts",
    "services.d.ts"
  ],
  "targets": { "main": { "entry": "reviewGitHubSetup.nl" } },
  "serviceBinding": "explicit",
  "serviceScopes": {
    "openGitHubWork": ["workOnGitHubGoal.nl", "workOnGitHubGoal/stageGitHubHandoff.nl"],
    "githubSetupRead": ["reviewGitHubSetup/readGitHubSetup.nl"],
    "githubSetupRoute": ["reviewGitHubSetup/resolveGitHubRoute.nl"],
    "githubDiagnosisRead": ["diagnoseGitHubOperation/readGitHubDiagnosis.nl"]
  }
}
