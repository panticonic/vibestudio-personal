{
  "name": "@workspace-workers/tour-sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibestudio": {
    "title": "Tour sample",
    "kind": "worker",
    "entry": "index.ts",
    "durable": {
      "classes": [
        {
          "className": "TourSample"
        }
      ]
    },
    "tests": [
      {
        "name": "native",
        "runtime": "native",
        "include": [
          "**/*.test.ts"
        ]
      }
    ],
    "authority": {
      "requests": [],
      "provides": [
        {
          "name": "sample.read",
          "title": "Read the tour sample",
          "action": "read a fictional reading-list item in the tour",
          "description": "Only a built-in sample. No personal data, network access, or changes to your workspace.",
          "tier": "gated",
          "sensitivity": "read",
          "resourceType": "tour-sample",
          "presentation": {
            "domain": "files",
            "verb": "see"
          },
          "notability": "everyday",
          "grantScopes": [
            "once",
            "version"
          ]
        }
      ]
    },
    "services": [
      {
        "action": "use the tour’s fictional reading-list sample",
        "authority": {
          "principals": [
            "host",
            "code"
          ]
        },
        "description": "A read-only sample for trying real capability approvals. No personal data or external services.",
        "durableObject": {
          "className": "TourSample"
        },
        "name": "tour-sample",
        "notability": "everyday",
        "presentation": {
          "domain": "files",
          "verb": "see"
        },
        "protocols": [
          "vibestudio.tour-sample.v1"
        ],
        "title": "Tour sample"
      }
    ]
  },
  "dependencies": {
    "@workspace/runtime": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.7",
    "@vibestudio/durable": "workspace:*",
    "@vibestudio/rpc": "workspace:*",
    "@vibestudio/shared": "workspace:*",
    "@vibestudio/workspace": "workspace:*"
  }
}
