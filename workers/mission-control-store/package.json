{
  "name": "@workspace-workers/mission-control-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "vibestudio": {
    "title": "Mission Control data",
    "icon": "./assets/icon.svg",
    "entry": "index.ts",
    "durable": {
      "classes": [
        {
          "className": "MissionControlStore"
        }
      ]
    },
    "authority": {
      "provides": [],
      "serviceRequests": [
        {
          "protocol": "vibestudio.missions.v1",
          "availability": "required"
        },
        {
          "protocol": "vibestudio.channel.v1",
          "availability": "required"
        }
      ],
      "requests": [
        {
          "capability": "workspace.runtime-state.manage",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "workspace-service:missions",
          "resource": {
            "kind": "exact",
            "key": "do:workers/missions:MissionsDO:workspace-missions"
          },
          "tier": "gated",
          "evidence": "exact"
        },
        {
          "capability": "workspace-service:channel",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "userland:workers/missions/missions.run#*",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "userland:workers/missions/missions.edit#*",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "bounded-dynamic"
        }
      ]
    },
    "tests": [
      {
        "name": "native-contract",
        "runtime": "native",
        "include": [
          "**/*.test.ts"
        ]
      }
    ],
    "services": [
      {
        "action": "organize projects and agentic work",
        "authority": {
          "binding": {
            "declaredFor": [
              "panels/mission-control",
              "workers/mission-agent"
            ]
          },
          "principals": [
            "host",
            "user",
            "code",
            "session",
            "mission"
          ]
        },
        "description": "Projects, tasks, saved views and links to agent execution.",
        "durableObject": {
          "className": "MissionControlStore"
        },
        "name": "mission-control",
        "notability": "everyday",
        "presentation": {
          "domain": "automation",
          "verb": "manage"
        },
        "protocols": [
          "mission-control.v1"
        ],
        "title": "Mission Control"
      }
    ]
  },
  "dependencies": {
    "@workspace/runtime": "workspace:*",
    "@workspace/mission-control": "workspace:*",
    "@vibestudio/workspace-contracts": "workspace:*",
    "zod": "^3.25.76",
    "@workspace/agentic-core": "workspace:*",
    "@vibestudio/shared": "workspace:*"
  },
  "devDependencies": {
    "@vibestudio/service-schemas": "workspace:*",
    "vitest": "^3.2.7",
    "@vibestudio/durable": "workspace:*",
    "@vibestudio/rpc": "workspace:*"
  },
  "exports": {
    ".": "./index.ts",
    "./contract": "./contract.ts"
  }
}
