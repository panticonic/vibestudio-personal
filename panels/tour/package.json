{
  "name": "@workspace-panels/tour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.tsx",
    "./deck": "./deck.ts"
  },
  "vibestudio": {
    "title": "Vibestudio Tour",
    "icon": "./assets/icon.svg",
    "entry": "index.tsx",
    "description": "A short interactive tour of workspaces, connected websites, and software you can shape by asking",
    "exposeModules": [
      "react",
      "react/jsx-runtime",
      "react/jsx-dev-runtime",
      "@radix-ui/themes",
      "@workspace/react",
      "@workspace/runtime"
    ],
    "stateArgs": {
      "type": "object",
      "properties": {
        "scene": {
          "type": "string",
          "description": "Scene id from panels/tour/deck.ts"
        },
        "notes": {
          "type": "boolean",
          "description": "Presenter notes drawer open"
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "provides": [],
      "requests": [
        {
          "capability": "workspace-service:tour-sample",
          "resource": {
            "kind": "exact",
            "key": "do:workers/tour-sample:TourSample:sample"
          },
          "tier": "gated",
          "evidence": "exact"
        },
        {
          "capability": "userland:workers/tour-sample/sample.read#*",
          "resource": {
            "kind": "exact",
            "key": "tour-sample:do:workers/tour-sample:TourSample:sample"
          },
          "tier": "gated",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": "context"
          },
          "tier": "critical",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "workspace.runtime-state.manage",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        }
      ]
    }
  },
  "dependencies": {
    "@radix-ui/themes": "^3.3.0",
    "@vibestudio/shared": "workspace:*",
    "@workspace/react": "workspace:*",
    "@workspace/agentic-chat": "workspace:*",
    "@workspace/runtime": "workspace:*",
    "@workspace/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
