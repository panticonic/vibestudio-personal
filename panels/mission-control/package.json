{
  "name": "@workspace-panels/mission-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "vibestudio": {
    "title": "Mission Control",
    "description": "Projects, tasks, agent sessions and recurring work in one command center.",
    "icon": "./assets/icon.svg",
    "authority": {
      "provides": [],
      "serviceRequests": [
        {
          "protocol": "mission-control.v1",
          "availability": "required"
        },
        {
          "protocol": "vibestudio.channel.v1",
          "availability": "required"
        }
      ],
      "requests": [
        {
          "capability": "workspace-service:mission-control",
          "resource": {
            "kind": "exact",
            "key": "do:workers/mission-control-store:MissionControlStore:main"
          },
          "tier": "gated",
          "evidence": "exact"
        },
        {
          "capability": "workspace.runtime-state.manage",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": "context"
          },
          "tier": "critical",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "workspace-service:channel",
          "resource": {
            "kind": "exact",
            "key": "do:workers/pubsub-channel:PubSubChannel:mission-control-lead"
          },
          "tier": "gated",
          "evidence": "exact"
        }
      ]
    },
    "tests": [
      {
        "name": "native-ui",
        "runtime": "native",
        "include": [
          "**/*.test.tsx"
        ]
      }
    ],
    "entry": "index.tsx"
  },
  "dependencies": {
    "@workspace/runtime": "workspace:*",
    "@workspace/mission-control": "workspace:*",
    "@vibestudio/workspace-contracts": "workspace:*",
    "zod": "^3.25.76",
    "@workspace/react": "workspace:*",
    "@workspace/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@vibestudio/automation": "workspace:*",
    "@workspace/pubsub": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.7",
    "@testing-library/react": "^16.3.0"
  }
}
